# ELYNDRA ONLINE — copy to .env (never commit .env) and fill in. Real environment variables override this file.
NODE_ENV=production
# game server port; behind Caddy it listens on 127.0.0.1 only (HOST is chosen automatically when TRUST_PROXY=1)
PORT=3400
# HOST=127.0.0.1
PUBLIC_URL=https://play.example.com
# trust X-Forwarded-For / X-Forwarded-Proto from the reverse proxy (Caddy on the same machine)
TRUST_PROXY=1
# send plain-HTTP visitors to HTTPS (default on in production; localhost is never redirected)
FORCE_HTTPS=1
# SQLite database (default: data/elyndra.db). Backups go to data/backups/
# DATABASE_PATH=data/elyndra.db
BACKUP_KEEP=20
BACKUP_HOURS=24
# long random string (32+ chars), e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# logins that become ADMIN at start (comma separated). Roles are stored in the database; this never demotes anyone.
ADMIN_ACCOUNTS=
# password hashing cost (bcrypt, 10-14)
BCRYPT_COST=12
# optional: Google sign-in client id
# GOOGLE_CLIENT_ID=
